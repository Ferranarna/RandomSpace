<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_camara.xml: botón de cámara con el mismo estilo que el del menú (ic_hamburger):
    cuadrado redondeado de 48 dp, borde violeta y fondo morado, con la cámara dibujada solo con línea blanca.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Borde del cuadrado -->
    <path
        android:fillColor="@color/purple"
        android:pathData="M10,0 H38 A10,10 0 0 1 48,10 V38 A10,10 0 0 1 38,48 H10 A10,10 0 0 1 0,38 V10 A10,10 0 0 1 10,0 Z" />

    <!-- Fondo del cuadrado -->
    <path
        android:fillColor="@color/medium_purple"
        android:pathData="M10,3 H38 A7,7 0 0 1 45,10 V38 A7,7 0 0 1 38,45 H10 A7,7 0 0 1 3,38 V10 A7,7 0 0 1 10,3 Z" />

    <!-- Cuerpo de la cámara, con el visor arriba: solo línea blanca -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/white"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M11.4,17.7 H17.2 L19.8,14 H28.2 L30.8,17.7 H36.6 V35.5 H11.4 Z" />

    <!-- Lente: círculo de línea blanca, sin tocar el cuerpo -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/white"
        android:strokeWidth="2.5"
        android:pathData="M24,22.9 A3.7,3.7 0 1 1 24,30.3 A3.7,3.7 0 1 1 24,22.9 Z" />
</vector>