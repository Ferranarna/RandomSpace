<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_victory.xml: pantalla de victoria (sin scroll).
    Los datos que se ven aquí son de ejemplo: los rellena VictoryActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    tools:context=".ui.result.VictoryActivity">

    <!-- ========== BARRA SUPERIOR (compartida) ========== -->
    <include layout="@layout/barra_superior" />

    <!-- ========== CONTENIDO ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <View style="@style/Espaciador" />

        <include layout="@layout/titulo_pantalla" />

        <View style="@style/Espaciador" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/img_victoria" />

        <View style="@style/Espaciador" />

        <TextView
            style="@style/SubtituloResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/victoria_subtitulo" />

        <View style="@style/Espaciador" />

        <!-- Panel: bote ganado -->
        <LinearLayout
            style="@style/PanelMensaje"
            android:orientation="vertical">

            <ImageView
                style="@style/IconoPanel"
                android:layout_width="186dp"
                android:layout_height="121dp"
                android:layout_marginEnd="0dp"
                android:src="@drawable/ic_trofeo" />

            <TextView
                style="@style/TextoJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/victoria_ganado"
                android:textColor="@color/white" />

            <!-- 1.000 [moneda] x3 = -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBoteBase"
                    style="@style/Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/yellow"
                    tools:text="1.000" />
                <ImageView style="@style/Moneda" />
                <TextView
                    android:id="@+id/tvMultiplicador"
                    style="@style/Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/green"
                    tools:text="x3" />

                <TextView
                    style="@style/Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/igual"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- 3.000 [moneda] -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPremio"
                    style="@style/TextoJuego"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="3.000" />
                <ImageView style="@style/Moneda" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Espaciador" />

        <!-- Panel: saldo final y guardado (contorno morado) -->
        <LinearLayout
            style="@style/PanelMensaje"
            android:background="@drawable/panel_morado">

            <!-- Disquete -->
            <ImageView
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_disquete" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextoJuego"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/saldo_final"
                    android:textColor="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvSaldo"
                        style="@style/TextoJuego"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="4.000" />
                    <ImageView style="@style/Moneda" />
                </LinearLayout>

                <TextView
                    style="@style/TextoJuego"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/guardado"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Espaciador" />
    </LinearLayout>

    <!-- ========== BOTÓN VOLVER (fijo abajo) ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVolver"
            style="@style/BotonTitulo"
            android:background="@drawable/btn_cian"
            android:text="@string/btn_volver" />
    </LinearLayout>
</LinearLayout>