<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_help.xml: pantalla de ayuda "CÓMO JUGAR" (estática, sin scroll).
    Barra superior compartida, cuatro paneles de ayuda y botón VOLVER fijo abajo.
    Los textos con colores e iconos los rellena HelpActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    tools:context=".ui.help.HelpActivity">

    <!-- ========== BARRA SUPERIOR (compartida) ========== -->
    <include layout="@layout/barra_superior" />

    <!-- ========== CONTENIDO ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp">

        <View style="@style/Espaciador" />

        <!-- Logo "CÓMO JUGAR" -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_help" />

        <View style="@style/Espaciador" />

        <!-- Panel 1: como jugar -->
        <LinearLayout style="@style/PanelAyuda">
            <LinearLayout style="@style/ColumnaAyuda">
                <TextView android:id="@+id/tvAyudaMonedas" style="@style/TextoAyuda"
                    tools:text="EMPIEZAS CON 1000" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Espaciador" />

        <!-- Panel 2: victoria -->
        <LinearLayout style="@style/PanelAyuda">
            <LinearLayout style="@style/ColumnaAyuda">
                <TextView style="@style/TituloAyuda" android:text="@string/help_premio_titulo"
                    android:textColor="@color/green" />
                <View style="@style/LineaTitulo" />
                <TextView android:id="@+id/tvAyudaPremio" style="@style/TextoAyuda"
                    tools:text="3 BURGERS = TODO EL BOTE" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Espaciador" />

        <!-- Panel 3: derrota -->
        <LinearLayout style="@style/PanelAyuda">
            <LinearLayout style="@style/ColumnaAyuda">
                <TextView style="@style/TituloAyuda" android:text="@string/help_fin_titulo"
                    android:textColor="@color/red" />
                <View style="@style/LineaTitulo" />
                <TextView android:id="@+id/tvAyudaFin" style="@style/TextoAyuda"
                    tools:text="SALDO &lt; 10" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Espaciador" />

        <!-- Panel 4: bote progresivo -->
        <LinearLayout style="@style/PanelAyuda">
            <LinearLayout style="@style/ColumnaAyuda">
                <TextView style="@style/TituloAyuda" android:text="@string/help_bote_titulo"
                    android:textColor="@color/yellow" />
                <View style="@style/LineaTitulo" />
                <TextView android:id="@+id/tvAyudaBote" style="@style/TextoAyuda"
                    tools:text="EMPIEZA EN 1000" />
            </LinearLayout>
        </LinearLayout>

        <!-- Espacio flexible: separa los paneles del botón VOLVER -->
        <View style="@style/Espaciador" />
    </LinearLayout>

    <!-- ========== BOTÓN VOLVER ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:paddingTop="8dp"
        >

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVolver"
            style="@style/BotonTitulo"
            android:background="@drawable/btn_volver"
            android:text="@string/help_volver" />
    </LinearLayout>
</LinearLayout>