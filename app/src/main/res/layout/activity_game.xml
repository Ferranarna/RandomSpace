<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_game.xml: pantalla de la partida
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    tools:context=".ui.game.GameActivity">

    <!-- ========== BARRA SUPERIOR (compartida) ========== -->
    <include layout="@layout/barra_superior" />

    <!-- ========== CONTENIDO ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <View style="@style/Espaciador" />

        <!-- Logo -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_random_space" />

        <View style="@style/Espaciador" />

        <!-- Cartel del bote -->
        <include layout="@layout/cartel_bote" />

        <View style="@style/Espaciador" />

        <!-- Mensaje de la tirada, p. ej. "¡LLUVIA DE ESTRELLA!" -->
        <LinearLayout style="@style/PanelMensaje">
            <TextView
                android:id="@+id/tvMensaje"
                style="@style/TextoJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="¡LLUVIA DE ESTRELLAS!" />
        </LinearLayout>

        <!-- Rodillos: tres casillas -->
        <LinearLayout
            android:id="@+id/contenedorRodillos"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <!-- TODO: imágenes de ejemplo, se cambian desde el código al girar -->
            <ImageView
                android:id="@+id/rodillo1"
                style="@style/Rodillo"
                android:src="@drawable/rodillo_hamburguesa" />
            <ImageView
                android:id="@+id/rodillo2"
                style="@style/Rodillo"
                android:src="@drawable/rodillo_hamburguesa" />
            <ImageView
                android:id="@+id/rodillo3"
                style="@style/Rodillo"
                android:src="@drawable/rodillo_saturno" />
        </LinearLayout>

        <!-- Resultado de la tirada: "GANASTE: +200 [moneda]" o "PERDISTE: -150 [moneda]" -->
        <LinearLayout style="@style/PanelMensaje">
            <TextView
                android:id="@+id/tvResultadoTitulo"
                style="@style/TextoJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                tools:text="GANASTE: " />
            <TextView
                android:id="@+id/tvResultado"
                style="@style/TextoJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="+200" />
            <ImageView
                android:id="@+id/ivMonedaResultado"
                style="@style/Moneda" />
        </LinearLayout>

        <View style="@style/Espaciador" />

        <!-- Saldo del jugador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Hueco del tamaño del botón +, para alinear con la fila de abajo -->
            <View
                android:layout_width="56dp"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/panel_morado"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    style="@style/TextoJuego"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/saldo"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/tvSaldo"
                    style="@style/Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/yellow"
                    tools:text="1.200" />
                <ImageView style="@style/Moneda" />
            </LinearLayout>

            <!-- Hueco del tamaño del botón -, para alinear con la fila de abajo -->
            <View
                android:layout_width="56dp"
                android:layout_height="0dp" />
        </LinearLayout>

        <!-- Apuesta: [+] [APUESTA: 10] [-] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMas"
                style="@style/BotonApuesta"
                android:text="@string/btn_mas" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/panel_magenta"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    style="@style/TextoJuego"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/apuesta_titulo"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/tvApuesta"
                    style="@style/TextoJuego"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/green"
                    tools:text="10" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMenos"
                style="@style/BotonApuesta"
                android:text="@string/btn_menos" />
        </LinearLayout>

        <View style="@style/Espaciador" />
    </LinearLayout>

    <!-- ========== BOTONES GIRAR Y VOLVER (fijos abajo) ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGirar"
            style="@style/BotonTitulo"
            android:background="@drawable/btn_verde"
            android:text="@string/btn_girar" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVolver"
            style="@style/BotonTitulo"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_cian"
            android:text="@string/btn_volver" />
    </LinearLayout>
</LinearLayout>