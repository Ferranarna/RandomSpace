<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml: diseño de la pantalla de inicio de Random Space.

    Los textos están en strings.xml, los colores en colors.xml y los estilos
    (Texto, TextoMonedas, Panel, Espaciador...) en themes.xml.
    Los atributos tools:text solo se ven en la vista previa de Android Studio (es temporal)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    tools:context=".ui.welcome.MainActivity">

    <!-- ========== BARRA SUPERIOR (compartida) ========== -->
    <include layout="@layout/barra_superior" />

    <!-- ========== CONTENIDO  ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <View style="@style/Espaciador" />

        <!-- Logo -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_random_space" />

        <View style="@style/Espaciador" />

        <!-- Cartel del bote (compartido) -->
        <include layout="@layout/cartel_bote" />

        <View style="@style/Espaciador" />

        <!-- Panel usuario y saldo -->
        <LinearLayout style="@style/Panel">

            <!-- Usuario: "USER:" a la izquierda, nombre a la derecha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="0dp">

                <TextView
                    style="@style/TextoJuego"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/user_titulo"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvUsuario"
                    style="@style/Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:textColor="@color/green"
                    tools:text="CYBER_GAMBLER" />
            </LinearLayout>

            <!-- Saldo: "SALDO:" a la izquierda, cantidad y moneda a la derecha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    style="@style/TextoJuego"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/saldo"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvMonedas"
                    style="@style/Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="1.000" />

                <ImageView style="@style/Moneda" />
            </LinearLayout>
        </LinearLayout>

        <!-- Panel de mejores partidas (3 filas) -->
        <LinearLayout
            style="@style/Panel"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/TextoJuego"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="3dp"
                android:textColor="@color/white"
                android:text="@string/tus_mejores_partidas" />

            <!-- Fila 1 -->
            <LinearLayout style="@style/FilaPuntuacion">
                <TextView
                    android:id="@+id/tvFecha1"
                    style="@style/TextoFecha"
                    tools:text="16/10/2026" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPuntos1"
                        style="@style/TextoMonedas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="3500" />

                    <ImageView style="@style/Moneda" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fila 2 -->
            <LinearLayout style="@style/FilaPuntuacion">
                <TextView
                    android:id="@+id/tvFecha2"
                    style="@style/TextoFecha"
                    tools:text="15/10/2026" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPuntos2"
                        style="@style/TextoMonedas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="2800" />

                    <ImageView style="@style/Moneda" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fila 3 -->
            <LinearLayout style="@style/FilaPuntuacion">
                <TextView
                    android:id="@+id/tvFecha3"
                    style="@style/TextoFecha"
                    tools:text="14/10/2026" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPuntos3"
                        style="@style/TextoMonedas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="1.000" />

                    <ImageView style="@style/Moneda" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fila 4 -->
            <LinearLayout style="@style/FilaPuntuacion">
                <TextView
                    android:id="@+id/tvFecha4"
                    style="@style/TextoFecha"
                    tools:text="13/10/2026" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPuntos4"
                        style="@style/TextoMonedas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="900" />

                    <ImageView style="@style/Moneda" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fila 5 -->
            <LinearLayout style="@style/FilaPuntuacion">
                <TextView
                    android:id="@+id/tvFecha5"
                    style="@style/TextoFecha"
                    tools:text="12/10/2026" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPuntos5"
                        style="@style/TextoMonedas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="750" />

                    <ImageView style="@style/Moneda" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Separador entre los paneles y los botones -->
        <View style="@style/Espaciador" />
    </LinearLayout>

    <!-- ========== BOTONES (fijos abajo) ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnJugar"
            style="@style/BotonTitulo"
            android:background="@drawable/btn_verde"
            android:text="@string/btn_jugar" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHistorial"
            style="@style/BotonTitulo"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_cian"
            android:text="@string/btn_historial" />
    </LinearLayout>
</LinearLayout>