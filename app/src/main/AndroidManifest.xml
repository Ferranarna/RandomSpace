<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RandomSpace">
        <activity
            android:name=".ui.name.NameActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.welcome.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.help.HelpActivity"
            android:exported="false" />

        <activity
            android:name=".ui.game.GameActivity"
            android:exported="false" />

        <activity
            android:name=".ui.result.VictoryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.result.DefeatActivity"
            android:exported="false" />

        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.prizes.PrizesActivity"
            android:exported="false" />
    </application>

</manifest>